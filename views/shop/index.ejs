<%- include('../partials/header') %>
<!-- Hero Banner สไตล์ Lab valley (แสดงเฉพาะตอนอยู่หน้าหลักและไม่ได้กดค้นหา) -->
<% if (!q && !selectedCategory) { %>
  <section class="hero-banner">
    <div class="hero-image">
      <img 
        src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=900&q=80" 
        alt="Lab Equipment & Chemical Supply" 
      />
    </div>
    <div class="hero-content">
      <h1>Mini Chemical Shop</h1>
      <p>
        จัดจำหน่ายสินค้าทางวิทยาศาสตร์ อาทิ เคมีภัณฑ์ เครื่องแก้ว และวัสดุวิทยาศาสตร์ 
        สำหรับงานวิจัย แผนกตรวจสอบคุณภาพ หรือแผนกรับประกันคุณภาพในห้องปฏิบัติการ 
        ของโรงเรียน มหาวิทยาลัย และโรงงานอุตสาหกรรม
      </p>
    </div>
  </section>
<% } %>

<!-- แถบ Breadcrumb & ตัวเลือกเรียงลำดับด้านบน (เหมือนหน้าเว็บตัวอย่าง) -->
<div class="shop-topbar">
  <div class="breadcrumb">
    <a href="/">HOME</a> / <span>SHOP</span>
    <% if (selectedCategory) { %>
      / <strong><%= selectedCategory.toUpperCase() %></strong>
    <% } %>
  </div>

  <div class="shop-controls">
    <span class="result-count">Showing all <%= products.length %> results</span>
    
    <!-- ฟอร์มเรียงลำดับ (Default sorting) โดยรักษาค่า q และ category เดิมไว้ -->
    <form method="GET" action="/" class="sort-form">
      <% if (q) { %><input type="hidden" name="q" value="<%= q %>" /><% } %>
      <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>" /><% } %>
      
      <select name="sort" onchange="this.form.submit()">
        <option value="default" <%= sort === 'default' ? 'selected' : '' %>>Default sorting</option>
        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>เรียงราคา: ต่ำไปสูง</option>
        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>เรียงราคา: สูงไปต่ำ</option>
        <option value="name_asc" <%= sort === 'name_asc' ? 'selected' : '' %>>เรียงตามชื่อ: A - Z</option>
      </select>
    </form>
  </div>
</div>

<!-- โครงสร้าง 2 คอลัมน์: ซ้ายเป็นเมนู BROWSE / ขวาเป็นตารางสินค้า 3 คอลัมน์ -->
<div class="shop-layout">
  <!-- แถบด้านซ้าย: BROWSE หมวดหมู่ -->
  <aside class="shop-sidebar">
    <h3 class="sidebar-title">BROWSE</h3>
    <ul class="category-list">
      <li>
        <a href="/" class="<%= !selectedCategory ? 'active' : '' %>">สินค้าทั้งหมด (All)</a>
      </li>
      <% categories.forEach(cat => { %>
        <li>
          <a 
            href="/?category=<%= encodeURIComponent(cat) %><%= q ? '&q=' + encodeURIComponent(q) : '' %>" 
            class="<%= selectedCategory === cat ? 'active' : '' %>"
          >
            <%= cat %>
          </a>
        </li>
      <% }) %>
    </ul>
  </aside>

  <!-- พื้นที่แสดงรายการสินค้า -->
  <section class="shop-products">
    <% if (products.length > 0) { %>
      <div class="product-grid">
        <% products.forEach(p => { %>
          <article class="product-card">
            <!-- กล่องรูปภาพ + ป้ายวงกลม Sale! / New มุมซ้ายบน -->
            <div class="product-image-wrap">
              <div class="badges">
                <% if (p.isOnSale) { %>
                  <span class="badge badge-sale">Sale!</span>
                <% } %>
                <% if (p.isNewProduct) { %>
                  <span class="badge badge-new">New</span>
                <% } %>
              </div>

              <img 
                src="<%= p.imageUrl || 'https://via.placeholder.com/300x300?text=Chemical+Product' %>" 
                alt="<%= p.name %>" 
              />
            </div>

            <!-- รายละเอียดสินค้า (จัดกึ่งกลางเหมือนเว็บตัวอย่าง) -->
            <div class="product-info">
              <span class="product-category"><%= p.category.toUpperCase() %></span>
              <h2 class="product-title"><%= p.name %></h2>

              <!-- การแสดงผลราคา (รองรับ 3 แบบ: ลดราคา / ราคาปกติ / ไม่มีราคา) -->
              <div class="product-price">
                <% if (p.isOnSale) { %>
                  <del class="old-price">฿<%= p.price.toLocaleString('th-TH', { minimumFractionDigits: 2 }) %></del>
                  <strong class="sale-price">฿<%= p.salePrice.toLocaleString('th-TH', { minimumFractionDigits: 2 }) %></strong>
                <% } else if (p.price !== null && p.price !== undefined) { %>
                  <strong>฿<%= p.price.toLocaleString('th-TH', { minimumFractionDigits: 2 }) %></strong>
                <% } else { %>
                  <span class="no-price">ติดต่อสอบถาม / ขอใบเสนอราคา</span>
                <% } %>
              </div>

              <!-- ปุ่มเพิ่มลงตะกร้า หรือ ขอใบเสนอราคา -->
              <form method="POST" action="/cart/add/<%= p.id %>" class="add-cart-form">
                <button type="submit" <%= p.stock === 0 ? 'disabled' : '' %>>
                  <% if (p.stock === 0) { %>
                    สินค้าหมด
                  <% } else if (p.price === null) { %>
                    เพิ่มลงรายการขอราคา
                  <% } else { %>
                    เพิ่มลงตะกร้า (<%= p.stock %>)
                  <% } %>
                </button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>ไม่พบรายการสินค้าที่ค้นหา</p>
        <a href="/">ดูสินค้าทั้งหมด</a>
      </div>
    <% } %>
  </section>
</div>

<%- include('../partials/footer') %>
